{
  "$description": "Design tokens da marca TRIO. Cores em RGB, para uso digital. A paleta de impresso esta em color.impresso e nao deve ser usada em tela.",
  "color": {
    "institucional": {
      "bordo":  { "$value": "#510303", "$type": "color", "$description": "Primaria. Titulos, CTAs, fundos de destaque." },
      "bege":   { "$value": "#F9F8F4", "$type": "color", "$description": "Fundo padrao." },
      "cinza":  { "$value": "#BFB8AF", "$type": "color", "$description": "Superficie e divisoria. Nunca texto: 1,5:1 sobre bege." },
      "preto":  { "$value": "#231D1A", "$type": "color", "$description": "Texto corrido." },
      "branco": { "$value": "#FFFFFF", "$type": "color", "$description": "Assinaturas de espaco sobre fundo colorido." }
    },
    "espaco": {
      "$description": "Cor de fundo de cada espaco. A assinatura entra em branco por cima.",
      "pergola":      { "$value": "#937F70", "$type": "color" },
      "one":          { "$value": "#ABAEAB", "$type": "color" },
      "garden":       { "$value": "#354C2C", "$type": "color" },
      "river-one":    { "$value": "#79776A", "$type": "color" },
      "sky-lounge":   { "$value": "#3E4A54", "$type": "color" },
      "dezenove":     { "$value": "#253746", "$type": "color" },
      "metropolitan": { "$value": "#636968", "$type": "color" },
      "sp-hall":      { "$value": "#67604B", "$type": "color" },
      "terraco":      { "$value": "#C6A992", "$type": "color" },
      "trivento":     { "$value": "#67604B", "$type": "color" }
    },
    "impresso": {
      "$description": "USO EXCLUSIVO EM IMPRESSO. Nao converter nem usar em digital.",
      "bordo": { "$value": "#790E17", "$type": "color", "$description": "Pantone 188 C / CMYK 0 99 73 60" },
      "cinza": { "$value": "#CFCAC3", "$type": "color", "$description": "Pantone Warm Gray 3 C / CMYK 0 4 8 25" },
      "bege":  { "$value": "#F5F4EE", "$type": "color", "$description": "CMYK 3 2 5 0" },
      "preto": { "$value": "#231D1A", "$type": "color", "$description": "Pantone 419 C / CMYK 68 66 63 82" }
    }
  },
  "font": {
    "familia": {
      "titulo": { "$value": "Miller Headline", "$type": "fontFamily", "$description": "Serifa. Licenca comercial Font Bureau." },
      "texto":  { "$value": "General Sans", "$type": "fontFamily" },
      "mono":   { "$value": "Chivo Mono", "$type": "fontFamily", "$description": "Labels e textos pontuais. SIL OFL." }
    },
    "tamanho": {
      "display": { "$value": "88px", "$type": "dimension", "$description": "44px em mobile" },
      "h1":      { "$value": "56px", "$type": "dimension", "$description": "34px em mobile" },
      "h2":      { "$value": "36px", "$type": "dimension", "$description": "26px em mobile" },
      "h3":      { "$value": "24px", "$type": "dimension", "$description": "20px em mobile" },
      "body":    { "$value": "18px", "$type": "dimension", "$description": "16px em mobile" },
      "label":   { "$value": "13px", "$type": "dimension" }
    },
    "entrelinha": {
      "titulo": { "$value": 1.08, "$type": "number" },
      "texto":  { "$value": 1.6,  "$type": "number" }
    },
    "tracking": {
      "titulo": { "$value": "-0.01em", "$type": "dimension" },
      "label":  { "$value": "0.08em",  "$type": "dimension", "$description": "Overline em caixa alta" }
    }
  },
  "espacamento": {
    "$description": "Escala base 8.",
    "1": { "$value": "4px",   "$type": "dimension" },
    "2": { "$value": "8px",   "$type": "dimension" },
    "3": { "$value": "16px",  "$type": "dimension" },
    "4": { "$value": "24px",  "$type": "dimension" },
    "5": { "$value": "32px",  "$type": "dimension" },
    "6": { "$value": "48px",  "$type": "dimension" },
    "7": { "$value": "64px",  "$type": "dimension" },
    "8": { "$value": "96px",  "$type": "dimension" },
    "9": { "$value": "128px", "$type": "dimension", "$description": "Padding vertical de secao em desktop" }
  },
  "layout": {
    "container": { "$value": "1280px", "$type": "dimension" },
    "gutter":    { "$value": "24px",   "$type": "dimension" },
    "colunas":   { "$value": 12,       "$type": "number" }
  },
  "forma": {
    "raio":       { "$value": "0px", "$type": "dimension", "$description": "Maximo 2px. Cantos arredondados descaracterizam a marca." },
    "raio-sutil": { "$value": "2px", "$type": "dimension" },
    "borda":      { "$value": "1px", "$type": "dimension" }
  },
  "movimento": {
    "duracao": { "$value": "240ms", "$type": "duration", "$description": "Faixa util: 200 a 300ms" },
    "easing":  { "$value": "cubic-bezier(0.22, 0.61, 0.36, 1)", "$type": "cubicBezier" }
  },
  "logo": {
    "respiro": { "$value": 0.5, "$type": "number", "$description": "Area de respiro = 50% da altura do logo, em todos os lados" },
    "largura-minima-digital": {
      "com-assinatura": { "$value": "200pt", "$type": "dimension" },
      "isolado":        { "$value": "80pt",  "$type": "dimension", "$description": "Ver docs/pendencias.md: os limites parecem invertidos no manual original" }
    }
  }
